<resources>
    <style name="Theme.NurQuran" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#082F24</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_nurquran</item>
        <item name="postSplashScreenTheme">@style/Theme.NurQuran.Normal</item>
    </style>
    <style name="Theme.NurQuran.Normal" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#28765D</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#082F24</item>
        <item name="android:navigationBarColor">#082F24</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
